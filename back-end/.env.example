# Copier ce fichier en back-end/.env (ignoré par git) puis remplir les valeurs.
# En production, définir ces variables dans l'environnement du serveur.

DB_URL=jdbc:postgresql://localhost:5432/smartshop
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Au moins 32 caractères aléatoires. Générer avec : openssl rand -base64 48
JWT_SECRET=change-me-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRATION_HOURS=168

# Origines web autorisées (séparées par des virgules) ; l'app mobile n'en a pas besoin
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# "update" en développement, "validate" en production
DB_DDL_AUTO=update

# Adresse publique du serveur (QR code de vérification imprimé sur les factures)
APP_PUBLIC_URL=http://localhost:8080

# Mettre false en production pour masquer /swagger-ui.html
API_DOCS_ENABLED=true
