# Copier ces variables dans l'environnement avant de lancer Spring Boot.
# Ne jamais mettre les vraies valeurs dans Git.

DB_URL=jdbc:postgresql://localhost:5432/smartshop
DB_USERNAME=postgres
DB_PASSWORD=replace_with_your_postgres_password

# Generer une cle aleatoire d'au moins 32 octets (exemple: openssl rand -base64 32)
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes

# Remplacer * par les origines web autorisees en production.
CORS_ALLOWED_ORIGINS=*
