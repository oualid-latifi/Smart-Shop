{
  "expo": {
    "name": "SmartShop",
    "slug": "smartshop-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartshop.mobile",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1d4fd8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.smartshop.mobile",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "SmartShop utilise la caméra pour photographier les produits.",
          "photosPermission": "SmartShop accède à vos photos pour illustrer les produits.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "SmartShop utilise la caméra pour photographier les produits et scanner les codes-barres.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications"
    ],
    "scheme": "smartshop",
    "backgroundColor": "#0a1224"
  }
}
